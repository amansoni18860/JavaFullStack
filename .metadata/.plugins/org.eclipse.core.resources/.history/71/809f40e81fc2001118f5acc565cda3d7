    :root {
      --navy: #14213d;
      --blue: #2563eb;
      --blue-dark: #1d4ed8;
      --sky: #eff6ff;
      --mint: #dcfce7;
      --green: #16a34a;
      --orange: #f97316;
      --text: #1e293b;
      --muted: #64748b;
      --border: #e2e8f0;
      --white: #ffffff;
      --bg: #f8fafc;
      --shadow: 0 16px 45px rgba(30, 64, 175, 0.12);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: "DM Sans", sans-serif;
      color: var(--text);
      background: var(--bg);
      overflow-x: hidden;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    .container {
      width: min(1180px, calc(100% - 40px));
      margin: auto;
    }

    /* Navigation */
    header {
      background: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 10;
    }

    .navbar {
      height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 11px;
      font-family: "Plus Jakarta Sans", sans-serif;
      font-size: 1.32rem;
      font-weight: 800;
      color: var(--navy);
    }

    .brand-mark {
      width: 38px;
      height: 38px;
      display: grid;
      place-items: center;
      border-radius: 11px;
      color: white;
      background: linear-gradient(135deg, #2563eb, #4f46e5);
      box-shadow: 0 7px 15px rgba(37, 99, 235, 0.27);
    }

    nav {
      display: flex;
      align-items: center;
      gap: 28px;
      color: #475569;
      font-size: 0.94rem;
      font-weight: 600;
    }

    nav a:hover {
      color: var(--blue);
    }

    .nav-actions {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border: none;
      cursor: pointer;
      font: inherit;
      font-weight: 700;
      border-radius: 10px;
      padding: 12px 18px;
      transition: 0.2s ease;
    }

    .btn-outline {
      color: var(--blue);
      border: 1px solid #bfdbfe;
      background: #fff;
    }

    .btn-outline:hover {
      background: var(--sky);
      transform: translateY(-1px);
    }

    .btn-primary {
      color: white;
      background: var(--blue);
      box-shadow: 0 8px 18px rgba(37, 99, 235, 0.22);
    }

    .btn-primary:hover {
      background: var(--blue-dark);
      transform: translateY(-2px);
    }

    /* Hero */
    .hero {
      position: relative;
      overflow: hidden;
      padding: 85px 0 75px;
      background:
        radial-gradient(circle at 85% 20%, rgba(147, 197, 253, 0.38), transparent 27%),
        radial-gradient(circle at 20% 90%, rgba(167, 243, 208, 0.36), transparent 25%),
        linear-gradient(135deg, #f8fbff 0%, #eff6ff 55%, #f0fdf4 100%);
    }

    .hero::before,
    .hero::after {
      content: "";
      position: absolute;
      border-radius: 50%;
      border: 1px solid rgba(37, 99, 235, 0.1);
    }

    .hero::before {
      width: 530px;
      height: 530px;
      top: -350px;
      right: -120px;
    }

    .hero::after {
      width: 360px;
      height: 360px;
      bottom: -260px;
      left: -110px;
    }

    .hero-grid {
      position: relative;
      display: grid;
      grid-template-columns: 1fr 0.95fr;
      align-items: center;
      gap: 55px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border: 1px solid #bfdbfe;
      border-radius: 99px;
      background: rgba(255, 255, 255, 0.75);
      color: var(--blue);
      font-size: 0.83rem;
      font-weight: 700;
    }

    .pulse {
      width: 8px;
      height: 8px;
      background: #22c55e;
      border-radius: 50%;
      box-shadow: 0 0 0 4px #dcfce7;
    }

    h1 {
      max-width: 650px;
      margin: 18px 0;
      font-family: "Plus Jakarta Sans", sans-serif;
      color: var(--navy);
      font-size: clamp(2.35rem, 4.2vw, 4.25rem);
      line-height: 1.12;
      letter-spacing: -0.05em;
    }

    h1 span {
      color: var(--blue);
    }

    .hero-text {
      max-width: 570px;
      color: var(--muted);
      font-size: 1.08rem;
      line-height: 1.75;
    }

    .hero-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 13px;
      margin-top: 28px;
    }

    .btn-large {
      padding: 15px 21px;
    }

    .trust-row {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 30px;
      color: #64748b;
      font-size: 0.9rem;
      font-weight: 600;
    }

    .avatars {
      display: flex;
    }

    .avatar {
      width: 31px;
      height: 31px;
      display: grid;
      place-items: center;
      margin-right: -8px;
      border: 2px solid white;
      border-radius: 50%;
      color: white;
      font-size: 0.66rem;
      font-weight: 800;
    }

    .a1 { background: #f97316; }
    .a2 { background: #8b5cf6; }
    .a3 { background: #0ea5e9; }
    .a4 { background: #14b8a6; }

    /* Dashboard preview */
    .dashboard {
      position: relative;
      border: 1px solid rgba(255, 255, 255, 0.8);
      border-radius: 20px;
      padding: 18px;
      background: rgba(255, 255, 255, 0.88);
      box-shadow: var(--shadow);
      transform: rotate(1.5deg);
    }

    .dashboard-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
    }

    .mini-brand {
      color: var(--navy);
      font-weight: 800;
      font-size: 0.9rem;
    }

    .dots {
      color: #94a3b8;
      letter-spacing: 2px;
    }

    .dashboard-content {
      display: grid;
      grid-template-columns: 112px 1fr;
      gap: 15px;
    }

    .side-panel {
      padding: 15px 10px;
      border-radius: 12px;
      color: #64748b;
      background: #f8fafc;
      font-size: 0.67rem;
      line-height: 2.8;
      font-weight: 700;
    }

    .side-panel .selected {
      display: block;
      padding-left: 8px;
      border-radius: 6px;
      color: var(--blue);
      background: #dbeafe;
    }

    .main-panel {
      min-width: 0;
    }

    .welcome-card {
      display: flex;
      justify-content: space-between;
      padding: 14px;
      border-radius: 11px;
      color: white;
      background: linear-gradient(125deg, #2563eb, #4f46e5);
    }

    .welcome-card small {
      opacity: 0.82;
      font-size: 0.66rem;
    }

    .welcome-card strong {
      display: block;
      margin-top: 4px;
      font-size: 0.9rem;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin: 12px 0;
    }

    .stat {
      padding: 10px;
      border: 1px solid var(--border);
      border-radius: 9px;
      background: white;
    }

    .stat small {
      display: block;
      color: #94a3b8;
      font-size: 0.58rem;
      font-weight: 700;
    }

    .stat b {
      display: block;
      margin-top: 4px;
      color: var(--navy);
      font-size: 1rem;
    }

    .employee-list {
      padding: 11px;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: white;
    }

    .employee-list h4 {
      margin-bottom: 9px;
      font-size: 0.73rem;
    }

    .employee {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 0;
      border-top: 1px solid #f1f5f9;
    }

    .employee:first-of-type { border-top: 0; }

    .employee-photo {
      width: 24px;
      height: 24px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      color: white;
      font-size: 0.54rem;
      font-weight: 800;
    }

    .employee-info {
      flex: 1;
    }

    .employee-info b,
    .employee-info span {
      display: block;
    }

    .employee-info b {
      color: #334155;
      font-size: 0.61rem;
    }

    .employee-info span {
      color: #94a3b8;
      font-size: 0.52rem;
    }

    .online {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #22c55e;
    }

    .floating-card {
      position: absolute;
      right: -28px;
      bottom: 25px;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 11px 14px;
      border: 1px solid #dcfce7;
      border-radius: 12px;
      background: white;
      box-shadow: 0 13px 30px rgba(15, 23, 42, 0.14);
      transform: rotate(-3deg);
    }

    .check-icon {
      width: 28px;
      height: 28px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      color: #15803d;
      background: #dcfce7;
      font-weight: 800;
    }

    .floating-card b {
      display: block;
      color: #334155;
      font-size: 0.72rem;
    }

    .floating-card small {
      color: #64748b;
      font-size: 0.63rem;
    }

    /* Quick actions */
    .actions {
      padding: 78px 0;
    }

    .section-heading {
      max-width: 670px;
      margin: 0 auto 35px;
      text-align: center;
    }

    .section-heading h2 {
      margin-bottom: 10px;
      color: var(--navy);
      font-family: "Plus Jakarta Sans", sans-serif;
      font-size: 2rem;
      letter-spacing: -0.04em;
    }

    .section-heading p {
      color: var(--muted);
      line-height: 1.6;
    }

    .action-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .action-card {
      position: relative;
      overflow: hidden;
      padding: 27px;
      border: 1px solid var(--border);
      border-radius: 17px;
      background: white;
      transition: 0.25s ease;
    }

    .action-card:hover {
      border-color: #bfdbfe;
      box-shadow: 0 14px 30px rgba(30, 64, 175, 0.1);
      transform: translateY(-6px);
    }

    .card-icon {
      width: 48px;
      height: 48px;
      display: grid;
      place-items: center;
      margin-bottom: 18px;
      border-radius: 13px;
      font-size: 1.4rem;
    }

    .add-icon { background: #dbeafe; }
    .view-icon { background: #dcfce7; }
    .report-icon { background: #ffedd5; }

    .action-card h3 {
      margin-bottom: 9px;
      color: var(--navy);
      font-family: "Plus Jakarta Sans", sans-serif;
      font-size: 1.16rem;
    }

    .action-card p {
      min-height: 52px;
      color: var(--muted);
      font-size: 0.92rem;
      line-height: 1.55;
    }

    .card-link {
      display: inline-flex;
      margin-top: 17px;
      color: var(--blue);
      font-size: 0.9rem;
      font-weight: 800;
    }

    .card-link:hover { text-decoration: underline; }

    /* Footer */
    footer {
      padding: 24px 0;
      border-top: 1px solid var(--border);
      background: white;
    }

    .footer-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: var(--muted);
      font-size: 0.88rem;
    }

    .footer-links {
      display: flex;
      gap: 18px;
    }

    .footer-links a:hover { color: var(--blue); }

    @media (max-width: 850px) {
      nav { display: none; }
      .hero-grid { grid-template-columns: 1fr; }
      .dashboard { max-width: 520px; margin: 15px auto 0; }
      .action-grid { grid-template-columns: 1fr; }
    }

    @media (max-width: 520px) {
      .navbar { height: 68px; }
      .nav-actions .btn-outline { display: none; }
      .hero { padding: 58px 0; }
      .dashboard-content { grid-template-columns: 85px 1fr; }
      .floating-card { right: -8px; }
      .footer-content { flex-direction: column; gap: 12px; }
    }