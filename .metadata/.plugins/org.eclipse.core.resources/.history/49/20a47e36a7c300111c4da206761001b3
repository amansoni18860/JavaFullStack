package com.example.mapping.demo;

import org.springframework.boot.CommandLineRunner;
import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.context.annotation.Bean;

import com.example.mapping.demo.dao.AppDAO;
import com.example.mapping.demo.entity.Course;
import com.example.mapping.demo.entity.Instructor;

@SpringBootApplication
public class LectZSpringBootHibernateMappingsApplication2 {

    public static void main(String[] args) {
        SpringApplication.run(LectZSpringBootHibernateMappingsApplication2.class, args);
    }

    @Bean
    public CommandLineRunner commandLineRunner(AppDAO appDAO) {

        return runner -> {

            createInstructorWithCourses(appDAO);

            findInstructor(appDAO);

            findCourse(appDAO);

            // deleteCourse(appDAO);

            // deleteInstructor(appDAO);
        };
    }
    
    
    private void createInstructorWithCourses(AppDAO appDAO) {

        Instructor instructor =
                new Instructor(
                        "John",
                        "Doe",
                        "john@gmail.com");

        Course course1 =
                new Course("Java Programming");

        Course course2 =
                new Course("Spring Boot");

        Course course3 =
                new Course("Hibernate");

        instructor.addCourse(course1);
        instructor.addCourse(course2);
        instructor.addCourse(course3);

        appDAO.save(instructor);

        System.out.println("Saved Successfully");
    }
    
    
    private void findInstructor(AppDAO appDAO) {

        int id = 1;

        Instructor instructor =
                appDAO.findInstructorById(id);

        System.out.println(instructor);

        for(Course temp : instructor.getCourses()) {

            System.out.println(temp);
        }
    }
    
    private void findCourse(AppDAO appDAO) {

        int id = 1;

        Course course =
                appDAO.findCourseById(id);

        System.out.println(course);

        System.out.println(course.getInstructor());
    }
    
    
}