<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Employees | PeopleFlow</title>

    <link rel="stylesheet" th:href="@{/css/style.css}">

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet">
        
        <link rel="stylesheet" href="@{/css/home.css}"/>
        <style>
        @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');

:root {
    --navy: #14213d;
    --blue: #2563eb;
    --blue-dark: #1d4ed8;
    --sky: #eff6ff;
    --green: #16a34a;
    --text: #1e293b;
    --muted: #64748b;
    --border: #e2e8f0;
    --background: #f8fafc;
    --white: #ffffff;
    --shadow: 0 14px 35px rgba(30, 64, 175, 0.10);
}

* {
    box-sizing: border-box;
}

body {
    min-height: 100vh;
    margin: 0;
    font-family: "DM Sans", sans-serif;
    color: var(--text);
    background:
        radial-gradient(
            circle at 90% 5%,
            rgba(147, 197, 253, 0.25),
            transparent 25%
        ),
        linear-gradient(135deg, #f8fbff 0%, #f8fafc 55%, #f0fdf4 100%);
}

/* Navbar */

.navbar {
    min-height: 76px;
    background: rgba(255, 255, 255, 0.96) !important;
    border-bottom: 1px solid var(--border);
}

.navbar-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--navy) !important;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 1.3rem;
    font-weight: 800;
}

.navbar-brand::before {
    content: "PF";
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 11px;
    color: white;
    background: linear-gradient(135deg, #2563eb, #4f46e5);
    box-shadow: 0 7px 15px rgba(37, 99, 235, 0.27);
    font-size: 0.8rem;
    font-weight: 800;
}

.navbar .nav-link {
    margin: 0 5px;
    color: #475569 !important;
    font-weight: 600;
}

.navbar .nav-link:hover,
.navbar .nav-link.active {
    color: var(--blue) !important;
}

.navbar .btn-light {
    padding: 9px 17px;
    border: 1px solid #bfdbfe;
    color: var(--blue);
    font-weight: 700;
    background: white;
}

.navbar .btn-light:hover {
    color: white;
    background: var(--blue);
}

/* Main content */

main.container {
    max-width: 1180px;
}

main {
    position: relative;
}

main h1 {
    color: var(--navy);
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 2.2rem;
    letter-spacing: -0.04em;
}

main p {
    color: var(--muted);
}

/* Add employee button */

.btn-primary {
    border: none;
    border-radius: 10px;
    padding: 11px 18px;
    color: white;
    background: var(--blue);
    box-shadow: 0 8px 18px rgba(37, 99, 235, 0.20);
    font-weight: 700;
    transition: 0.2s ease;
}

.btn-primary:hover {
    border-color: var(--blue-dark);
    color: white;
    background: var(--blue-dark);
    box-shadow: 0 11px 22px rgba(37, 99, 235, 0.28);
    transform: translateY(-2px);
}

/* Employee card */

.card {
    overflow: hidden;
    border: 1px solid var(--border) !important;
    border-radius: 18px !important;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: var(--shadow) !important;
}

.card-body {
    background: white;
}

/* Table */

.table {
    margin-bottom: 0;
    color: var(--text);
}

.table thead {
    background: linear-gradient(135deg, #eff6ff, #eef2ff) !important;
}

.table thead th {
    padding: 17px 15px;
    border-bottom: 1px solid #dbeafe;
    color: #334155;
    background: transparent !important;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    white-space: nowrap;
}

.table tbody td {
    padding: 17px 15px;
    border-color: #f1f5f9;
    color: #475569;
    vertical-align: middle;
}

.table tbody tr {
    transition: 0.2s ease;
}

.table tbody tr:hover {
    background: #f8fbff;
    transform: scale(1.002);
}

.table tbody td strong {
    color: var(--navy);
    font-weight: 700;
}

/* Registration badge */

.table .badge {
    padding: 7px 10px;
    border-radius: 7px;
    color: var(--blue);
    background: #dbeafe !important;
    font-size: 0.75rem;
    font-weight: 700;
}

/* Skills badges */

.table .bg-info {
    margin: 2px;
    padding: 6px 9px;
    border: 1px solid #bae6fd;
    border-radius: 6px;
    color: #0369a1 !important;
    background: #e0f2fe !important;
    font-size: 0.72rem;
    font-weight: 700;
}

/* Action buttons */

.btn-sm {
    border-radius: 7px;
    padding: 6px 11px;
    font-size: 0.78rem;
    font-weight: 700;
}

.btn-outline-primary {
    border-color: #bfdbfe;
    color: var(--blue);
}

.btn-outline-primary:hover {
    border-color: var(--blue);
    background: var(--blue);
}

.btn-outline-danger {
    border-color: #fecaca;
    color: #dc2626;
}

.btn-outline-danger:hover {
    border-color: #dc2626;
    background: #dc2626;
}

/* Empty employee state */

.table tbody tr td[colspan] {
    padding: 65px 20px !important;
    background: #ffffff;
}

.table tbody tr td[colspan] h5 {
    margin-bottom: 8px;
    color: var(--navy);
    font-family: "Plus Jakarta Sans", sans-serif;
    font-weight: 700;
}

.table tbody tr td[colspan] p {
    margin-bottom: 20px;
}

/* Success message */

.alert-success {
    border: 1px solid #bbf7d0;
    border-radius: 11px;
    color: #166534;
    background: #f0fdf4;
}

/* Footer */

footer {
    border-top: 1px solid var(--border) !important;
    background: rgba(255, 255, 255, 0.85) !important;
}

footer p,
footer div {
    color: var(--muted);
}

/* Responsive design */

@media (max-width: 991px) {
    .navbar .nav-link {
        margin: 5px 0;
    }

    .navbar .nav-item.ms-lg-3 {
        margin-top: 10px;
        margin-left: 0 !important;
    }
}

@media (max-width: 768px) {
    main.container {
        padding-right: 18px;
        padding-left: 18px;
    }

    main h1 {
        font-size: 1.8rem;
    }

    .table thead th,
    .table tbody td {
        padding: 12px 10px;
    }

    .table {
        min-width: 950px;
    }

    .card-body {
        overflow-x: auto;
    }
}

@media (max-width: 480px) {
    main h1 {
        font-size: 1.6rem;
    }

    .navbar-brand {
        font-size: 1.1rem;
    }

    .navbar-brand::before {
        width: 34px;
        height: 34px;
    }
}</style>
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" th:href="@{/}">
                PeopleFlow
            </a>

            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    <li class="nav-item">
                        <a class="nav-link" th:href="@{/}">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link active" th:href="@{/employees}">
                            Employees
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" th:href="@{/employees/add}">
                            Add Employee
                        </a>
                    </li>

                    <li class="nav-item ms-lg-3">
                        <form th:action="@{/logout}" method="post">
                            <button type="submit" class="btn btn-light btn-sm">
                                Logout
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Page Content -->
    <main class="container py-5">

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
            <div>
                <h1 class="fw-bold text-dark mb-1">Employees</h1>
                <p class="text-muted mb-0">
                    Manage and view all registered employees.
                </p>
            </div>

            <a th:href="@{/employees/add}" class="btn btn-primary mt-3 mt-md-0">
                <span class="me-1">+</span> Add Employee
            </a>
        </div>

        <!-- Success message -->
        <div
            th:if="${successMessage}"
            class="alert alert-success alert-dismissible fade show"
            role="alert">
            <span th:text="${successMessage}"></span>

            <button
                type="button"
                class="btn-close"
                data-bs-dismiss="alert">
            </button>
        </div>

        <!-- Employee table -->
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-primary">
                            <tr>
                                <th>#</th>
                                <th>Registration ID</th>
                                <th>Employee Name</th>
                                <th>Gender</th>
                                <th>Department</th>
                                <th>Skills</th>
                                <th>Joining Date</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            <!-- Display employees -->
                            <tr th:each="employee, employeeStatus : ${employees}">
                                <td th:text="${employeeStatus.count}">1</td>

                                <td>
                                    <span
                                        class="badge bg-secondary"
                                        th:text="${employee.regId}">
                                        EMP001
                                    </span>
                                </td>

                                <td>
                                    <strong th:text="${employee.name}">
                                        John Doe
                                    </strong>
                                </td>

                                <td th:text="${employee.gender}">
                                    Male
                                </td>

                                <td th:text="${employee.department}">
                                    IT
                                </td>

                                <td>
                                    <span
                                        th:if="${employee.skills != null}"
                                        th:each="skill : ${employee.skills}"
                                        class="badge bg-info text-dark me-1"
                                        th:text="${skill}">
                                        Java
                                    </span>
                                </td>

                                <td
                                    th:text="${employee.joiningDate != null ? #dates.format(employee.joiningDate, 'dd-MM-yyyy') : 'N/A'}">
                                    01-01-2026
                                </td>

                                <td class="text-center">
                                    <a
                                        th:href="@{/employees/edit/{id}(id=${employee.empId})}"
                                        class="btn btn-sm btn-outline-primary me-1">
                                        Edit
                                    </a>

                                    <a
                                        th:href="@{/employees/delete(employeeId=${employee.empId})}"
                                        class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Are you sure you want to delete this employee?');">
                                        Delete
                                    </a>
                                </td>
                            </tr>

                            <!-- Empty state -->
                            <tr th:if="${employees == null or #lists.isEmpty(employees)}">
                                <td colspan="8" class="text-center py-5">
                                    <div class="text-muted">
                                        <h5>No employees found</h5>
                                        <p class="mb-3">
                                            Start by adding your first employee.
                                        </p>

                                        <a
                                            th:href="@{/employees/showFormForAdd}"
                                            class="btn btn-primary">
                                            Add Employee
                                        </a>
                                    </div>
                                </td>

                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </main>

    <footer class="bg-light border-top py-4 mt-5">
        <div class="container text-center text-muted">
            © 2026 PeopleFlow. Employee management made simple.
        </div>
    </footer>

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>