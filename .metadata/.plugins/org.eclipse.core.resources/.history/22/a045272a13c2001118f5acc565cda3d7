@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');

:root {
    --navy: #14213d;
    --blue: #2563eb;
    --blue-dark: #1d4ed8;
    --sky: #eff6ff;
    --green: #16a34a;
    --text: #1e293b;
    --muted: #64748b;
    --border: #e2e8f0;
    --background: #f8fafc;
    --white: #ffffff;
    --shadow: 0 14px 35px rgba(30, 64, 175, 0.10);
}

* {
    box-sizing: border-box;
}

body {
    min-height: 100vh;
    margin: 0;
    font-family: "DM Sans", sans-serif;
    color: var(--text);
    background:
        radial-gradient(
            circle at 90% 5%,
            rgba(147, 197, 253, 0.25),
            transparent 25%
        ),
        linear-gradient(135deg, #f8fbff 0%, #f8fafc 55%, #f0fdf4 100%);
}

/* Navbar */

.navbar {
    min-height: 76px;
    background: rgba(255, 255, 255, 0.96) !important;
    border-bottom: 1px solid var(--border);
}

.navbar-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--navy) !important;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 1.3rem;
    font-weight: 800;
}

.navbar-brand::before {
    content: "PF";
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 11px;
    color: white;
    background: linear-gradient(135deg, #2563eb, #4f46e5);
    box-shadow: 0 7px 15px rgba(37, 99, 235, 0.27);
    font-size: 0.8rem;
    font-weight: 800;
}

.navbar .nav-link {
    margin: 0 5px;
    color: #475569 !important;
    font-weight: 600;
}

.navbar .nav-link:hover,
.navbar .nav-link.active {
    color: var(--blue) !important;
}

.navbar .btn-light {
    padding: 9px 17px;
    border: 1px solid #bfdbfe;
    color: var(--blue);
    font-weight: 700;
    background: white;
}

.navbar .btn-light:hover {
    color: white;
    background: var(--blue);
}

/* Main content */

main.container {
    max-width: 1180px;
}

main {
    position: relative;
}

main h1 {
    color: var(--navy);
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 2.2rem;
    letter-spacing: -0.04em;
}

main p {
    color: var(--muted);
}

/* Add employee button */

.btn-primary {
    border: none;
    border-radius: 10px;
    padding: 11px 18px;
    color: white;
    background: var(--blue);
    box-shadow: 0 8px 18px rgba(37, 99, 235, 0.20);
    font-weight: 700;
    transition: 0.2s ease;
}

.btn-primary:hover {
    border-color: var(--blue-dark);
    color: white;
    background: var(--blue-dark);
    box-shadow: 0 11px 22px rgba(37, 99, 235, 0.28);
    transform: translateY(-2px);
}

/* Employee card */

.card {
    overflow: hidden;
    border: 1px solid var(--border) !important;
    border-radius: 18px !important;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: var(--shadow) !important;
}

.card-body {
    background: white;
}

/* Table */

.table {
    margin-bottom: 0;
    color: var(--text);
}

.table thead {
    background: linear-gradient(135deg, #eff6ff, #eef2ff) !important;
}

.table thead th {
    padding: 17px 15px;
    border-bottom: 1px solid #dbeafe;
    color: #334155;
    background: transparent !important;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    white-space: nowrap;
}

.table tbody td {
    padding: 17px 15px;
    border-color: #f1f5f9;
    color: #475569;
    vertical-align: middle;
}

.table tbody tr {
    transition: 0.2s ease;
}

.table tbody tr:hover {
    background: #f8fbff;
    transform: scale(1.002);
}

.table tbody td strong {
    color: var(--navy);
    font-weight: 700;
}

/* Registration badge */

.table .badge {
    padding: 7px 10px;
    border-radius: 7px;
    color: var(--blue);
    background: #dbeafe !important;
    font-size: 0.75rem;
    font-weight: 700;
}

/* Skills badges */

.table .bg-info {
    margin: 2px;
    padding: 6px 9px;
    border: 1px solid #bae6fd;
    border-radius: 6px;
    color: #0369a1 !important;
    background: #e0f2fe !important;
    font-size: 0.72rem;
    font-weight: 700;
}

/* Action buttons */

.btn-sm {
    border-radius: 7px;
    padding: 6px 11px;
    font-size: 0.78rem;
    font-weight: 700;
}

.btn-outline-primary {
    border-color: #bfdbfe;
    color: var(--blue);
}

.btn-outline-primary:hover {
    border-color: var(--blue);
    background: var(--blue);
}

.btn-outline-danger {
    border-color: #fecaca;
    color: #dc2626;
}

.btn-outline-danger:hover {
    border-color: #dc2626;
    background: #dc2626;
}

/* Empty employee state */

.table tbody tr td[colspan] {
    padding: 65px 20px !important;
    background: #ffffff;
}

.table tbody tr td[colspan] h5 {
    margin-bottom: 8px;
    color: var(--navy);
    font-family: "Plus Jakarta Sans", sans-serif;
    font-weight: 700;
}

.table tbody tr td[colspan] p {
    margin-bottom: 20px;
}

/* Success message */

.alert-success {
    border: 1px solid #bbf7d0;
    border-radius: 11px;
    color: #166534;
    background: #f0fdf4;
}

/* Footer */

footer {
    border-top: 1px solid var(--border) !important;
    background: rgba(255, 255, 255, 0.85) !important;
}

footer p,
footer div {
    color: var(--muted);
}

/* Responsive design */

@media (max-width: 991px) {
    .navbar .nav-link {
        margin: 5px 0;
    }

    .navbar .nav-item.ms-lg-3 {
        margin-top: 10px;
        margin-left: 0 !important;
    }
}

@media (max-width: 768px) {
    main.container {
        padding-right: 18px;
        padding-left: 18px;
    }

    main h1 {
        font-size: 1.8rem;
    }

    .table thead th,
    .table tbody td {
        padding: 12px 10px;
    }

    .table {
        min-width: 950px;
    }

    .card-body {
        overflow-x: auto;
    }
}

@media (max-width: 480px) {
    main h1 {
        font-size: 1.6rem;
    }

    .navbar-brand {
        font-size: 1.1rem;
    }

    .navbar-brand::before {
        width: 34px;
        height: 34px;
    }
}