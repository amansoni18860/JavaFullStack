<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PeopleFlow | Employee Management System</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
    rel="stylesheet"
  />

    <link rel="stylesheet" th:href="@{/css/home.css}"/>

</head>

<body>
  <header>
    <div class="container navbar">
      <a href="#" class="brand">
        <span class="brand-mark">PF</span>
        PeopleFlow
      </a>

      <nav>
        <a href="#home">Home</a>
        <a href="#features">Features</a>
        <a href="#employees">Employees</a>
        <a href="#reports">Reports</a>
      </nav>

      <div class="nav-actions">
        <a href="login.html" class="btn btn-outline">Login</a>
        <a href="logout.html" class="btn btn-primary">Logout</a>
      </div>
    </div>
  </header>

  <main>
    <section class="hero" id="home">
      <div class="container hero-grid">
        <div>
          <div class="eyebrow">
            <span class="pulse"></span>
            Smart workforce management
          </div>

          <h1>Manage your people. <span>Empower your business.</span></h1>

          <p class="hero-text">
            A simple, secure, and efficient way to manage your workforce—
            from employee records and attendance to team insights.
          </p>

          <div class="hero-buttons">
            <a href="add-employee.html" class="btn btn-primary btn-large">
              <span>＋</span> Add Employee
            </a>
            <a href="employees.html" class="btn btn-outline btn-large">
              View Employees →
            </a>
          </div>

          <div class="trust-row">
            <div class="avatars">
              <span class="avatar a1">AM</span>
              <span class="avatar a2">JS</span>
              <span class="avatar a3">RK</span>
              <span class="avatar a4">+2K</span>
            </div>
            Trusted by teams managing 2,000+ employees
          </div>
        </div>

        <div class="dashboard">
          <div class="dashboard-top">
            <span class="mini-brand">PeopleFlow Dashboard</span>
            <span class="dots">•••</span>
          </div>

          <div class="dashboard-content">
            <aside class="side-panel">
              <span class="selected">▣ Dashboard</span>
              <span>♙ Employees</span>
              <span>◷ Attendance</span>
              <span>▤ Reports</span>
              <span>⚙ Settings</span>
            </aside>

            <div class="main-panel">
              <div class="welcome-card">
                <div>
                  <small>Good morning, Admin</small>
                  <strong>Here is your team overview</strong>
                </div>
                <span>👋</span>
              </div>

              <div class="stats">
                <div class="stat">
                  <small>TOTAL EMPLOYEES</small>
                  <b>1,248</b>
                </div>
                <div class="stat">
                  <small>PRESENT TODAY</small>
                  <b>1,196</b>
                </div>
                <div class="stat">
                  <small>ON LEAVE</small>
                  <b>32</b>
                </div>
              </div>

              <div class="employee-list">
                <h4>Recent Employees</h4>

                <div class="employee">
                  <span class="employee-photo a1">AM</span>
                  <div class="employee-info">
                    <b>Amelia Morgan</b>
                    <span>Product Designer</span>
                  </div>
                  <span class="online"></span>
                </div>

                <div class="employee">
                  <span class="employee-photo a2">JD</span>
                  <div class="employee-info">
                    <b>James Davis</b>
                    <span>Software Engineer</span>
                  </div>
                  <span class="online"></span>
                </div>

                <div class="employee">
                  <span class="employee-photo a3">SR</span>
                  <div class="employee-info">
                    <b>Sarah Robinson</b>
                    <span>HR Manager</span>
                  </div>
                  <span class="online"></span>
                </div>
              </div>
            </div>
          </div>

          <div class="floating-card">
            <span class="check-icon">✓</span>
            <div>
              <b>Employee added!</b>
              <small>Profile successfully created</small>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="actions" id="features">
      <div class="container">
        <div class="section-heading">
          <h2>Everything your team needs, in one place</h2>
          <p>
            Streamline everyday HR tasks and keep your employee information
            organized, accessible, and secure.
          </p>
        </div>

        <div class="action-grid">
          <article class="action-card">
            <div class="card-icon add-icon">👤</div>
            <h3>Add Employee</h3>
            <p>
              Create employee profiles, assign departments, roles, and contact details with ease.
            </p>
            <a href="add-employee.html" class="card-link">Add a new employee →</a>
          </article>

          <article class="action-card" id="employees">
            <div class="card-icon view-icon">👥</div>
            <h3>View Employees</h3>
            <p>
              Browse, search, filter, and update all employee records from one central directory.
            </p>
            <a href="employees.html" class="card-link">Open employee directory →</a>
          </article>

          <article class="action-card" id="reports">
            <div class="card-icon report-icon">📊</div>
            <h3>Reports & Insights</h3>
            <p>
              Track attendance, team growth, department data, and workforce performance.
            </p>
            <a href="reports.html" class="card-link">View reports →</a>
          </article>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container footer-content">
      <p>© 2026 PeopleFlow. Employee management made simple.</p>
      <div class="footer-links">
        <a href="#">Help Center</a>
        <a href="#">Privacy</a>
        <a href="logout.html">Logout</a>
      </div>
    </div>
  </footer>
</body>
</html>