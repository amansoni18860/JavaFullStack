package com.example.ems.demo.controller;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.example.ems.demo.entity.Employee;
import com.example.ems.demo.service.EmployeeService;

import jakarta.annotation.PostConstruct;

@RestController
@RequestMapping("/api")
public class EmployeeApiController {

	private EmployeeService empService;

	@Autowired
	public EmployeeApiController(EmployeeService theService) {
		this.empService = theService;

	}

	@PostConstruct
	public void postConstruct() {
		System.out.println("\n\nApplication is running...\n\n");
	}

	@GetMapping("/")
	public List<Employee> home() {
		return empService.findAll();
	}

}
