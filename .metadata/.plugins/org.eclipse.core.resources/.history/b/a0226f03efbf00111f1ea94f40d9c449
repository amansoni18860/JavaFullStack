<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <title>Thymeleaf Demo</title>
</head>
<body>

    <h1 th:text="${message}"></h1>

    <hr>

    <h2>Variable Example</h2>

    <p th:text="'Current User : Rahul'"></p>

    <hr>

    <h2>Condition Example</h2>

    <p th:if="${showMessage}">
        This text is shown because showMessage is true
    </p>

    <hr>

    <h2>Loop Example</h2>

    <table border="1">

        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Age</th>
        </tr>

        <tr th:each="student : ${students}">
            <td th:text="${student.firstName}"></td>
            <td th:text="${student.lastName}"></td>
            <td th:text="${student.age}"></td>
        </tr>

    </table>

    <hr>

    <a th:href="@{/students}">
        Refresh Page
    </a>

</body>
</html>